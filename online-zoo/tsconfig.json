{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"outDir": "./dist"
	},
	"include": ["pages/**/*.ts", "styles/**/*.ts", "types/**/*.ts", "api/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
